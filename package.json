{
  "name": "rimac-api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "integration": "vitest run --config vitest.integration.ts",
    "openapi": "tsx scripts/openapi.ts",
    "package": "tsx scripts/serverless.ts package",
    "bundle": "tsx scripts/bundle.ts",
    "deploy": "tsx scripts/serverless.ts deploy",
    "infra:validate": "tsx scripts/validate-infra.ts",
    "migrate": "tsx scripts/migrate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-cloudformation": "^3.1144.0",
    "@aws-sdk/client-cloudwatch": "^3.1144.0",
    "@aws-sdk/client-dynamodb": "^3.1144.0",
    "@aws-sdk/client-eventbridge": "^3.1144.0",
    "@aws-sdk/client-iam": "^3.1144.0",
    "@aws-sdk/client-lambda": "^3.1144.0",
    "@aws-sdk/client-rds-data": "^3.1144.0",
    "@aws-sdk/client-secrets-manager": "^3.1144.0",
    "@aws-sdk/client-sns": "^3.1144.0",
    "@aws-sdk/client-sqs": "^3.1144.0",
    "@aws-sdk/credential-providers": "^3.1144.0",
    "@aws-sdk/lib-dynamodb": "^3.1144.0",
    "@serverless/typescript": "^4.30.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "mysql2": "^3.24.5",
    "prettier": "^3.9.9",
    "serverless": "^4.43.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
